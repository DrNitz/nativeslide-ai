# ==============================================================================
# NativeSlide AI — Backend Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# Application
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","https://nativeslide.pages.dev"]

# Google AI Studio — 100% Free Tier (1,500 reqs/day)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase — 100% Free Tier (50,000 MAUs)
# Create project at: https://supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# JWT Authentication (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_32_byte_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Generation Limits
MAX_SLIDES=40
FREE_TIER_MAX_SLIDES=15
MAX_PDF_SIZE_MB=25
RATE_LIMIT_PER_MINUTE=10
OUTPUT_DIR=/tmp/nativeslide_outputs
